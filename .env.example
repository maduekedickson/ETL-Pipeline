# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
FLASK_ENV=production
DEBUG=False
PORT=5000

# AWS Region
AWS_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_USERS_TABLE=RiteClick_Users

# S3 Buckets Configuration
SOURCE_S3_BUCKET=riteclick-etl-source-data
TARGET_S3_BUCKET=riteclick-etl-processed-data

# AWS Glue Configuration
GLUE_JOB_NAME=riteclick-csv-to-json-job

# AWS SNS Configuration
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:riteclick-etl-notifications

# (Optional for local testing if not running on EC2 instance with IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
