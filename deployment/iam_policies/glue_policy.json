{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudWatchAndGlueServiceLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/aws-glue/*"
      ]
    },
    {
      "Sid": "SourceS3BucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::riteclick-source-bucket",
        "arn:aws:s3:::riteclick-source-bucket/*"
      ]
    },
    {
      "Sid": "TargetS3BucketWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::riteclick-target-bucket",
        "arn:aws:s3:::riteclick-target-bucket/*"
      ]
    },
    {
      "Sid": "GlueScriptsBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::aws-glue-*/*"
    }
  ]
}
